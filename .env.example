VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Email (Gmail App Password — Settings > Security > 2-Step > App Passwords)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Supabase service role key (for server-side user email lookup)
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile → Add site)
# Dev test keys (always pass): site=1x00000000000000000000AA  secret=1x0000000000000000000000000000000AA
VITE_TURNSTILE_SITE_KEY=   # public — goes into the client bundle
TURNSTILE_SECRET_KEY=      # server-only — used in api/verify-turnstile.ts
